# Optional override for the local application data directory.
# By default, Sky Walker uses %LOCALAPPDATA%\SkyWalker on Windows.
SKYWALKER_DATA_DIR=

# Local Ollama connection and preferred installed model.
SKYWALKER_OLLAMA_URL=http://127.0.0.1:11434
SKYWALKER_MODEL=qwen3.5:4b

# Optional local assistant instruction.
SKYWALKER_SYSTEM_PROMPT=You are Sky Walker, a helpful private desktop assistant.
